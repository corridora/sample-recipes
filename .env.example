# This is a reference; ./setup configure writes protected JSON files.
SAMPLE_MODE=local
PORT=4103
CORRIDORA_TARGET=own
CORRIDORA_OTLP_ENDPOINT=https://ingest.corridora.com
CORRIDORA_INGEST_KEY=
CORRIDORA_RUM_KEY=
CORRIDORA_RUM_SCRIPT_URL=https://rum.corridora.com/corridora-rum.js
OTEL_SERVICE_NAME=sample-recipes-api
OTEL_SERVICE_NAMESPACE=corridora-samples.recipes
DEPLOYMENT_ENVIRONMENT=development
RESOURCE_PREFIX=sample-recipes
# Setup derives SERVICE_VERSION from actual Git HEAD, or a source digest before first commit.
DEMO_CONTROL_TOKEN=
DEMO_DAILY_START_UTC=13:40
DEMO_WINDOW_SECONDS=600
ENABLE_PROVIDER_FORWARDING=false
ENABLE_SYNTHETICS=false
REVIEW_SUMMARY_URL=
DOWNSTREAM_AUTH_TOKEN=
GCP_PROJECT=
GCP_REGION=us-central1
FIRESTORE_DATABASE=(default)
FIRESTORE_CREATE_IF_MISSING=false
GCS_BUCKET=
REUSE_BUCKET=false
PUBSUB_TOPIC=
GCP_SERVICE_ACCOUNT=
PUSH_IDENTITY=
# Discovered during GCP deployment; exact same-origin API/RUM allowlist.
PUBLIC_URL=http://localhost:4103
